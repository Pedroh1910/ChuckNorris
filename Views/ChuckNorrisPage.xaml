<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChuckNorris.Views.ChuckNorrisPage"
             xmlns:viewmodel="clr-namespace:ChuckNorris.ViewModels"
             x:DataType="viewmodel:ChuckNorrisViewModel"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Padding="20" Spacing="20">

            <!-- HEADER -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="🤠 Chuck Norris Facts"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#FFF"
                       HorizontalOptions="Center" />
                <Label Text="Gere fatos aleatórios sobre o mito"
                       FontSize="15"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- CARD DE AÇÃO -->
            <Border Padding="20" 
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="15">
                    <Button Text="Gerar Fato Aleatório"
                            CornerRadius="16"
                            BackgroundColor="#6366F1"
                            TextColor="#FFF"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding ObterPiadaCommand}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#6366F1"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- CARD DE RESULTADO -->
            <Border Padding="25"
                    BackgroundColor="#1E293B"
                    Stroke="#10B981"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="2"
                    IsVisible="{Binding TemResultado}">

                <VerticalStackLayout Spacing="15">

                    <Image Source="{Binding Piada.IconUrl}"
                           HeightRequest="60"
                           WidthRequest="60"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1"
                             Color="#334155"
                             Margin="0,5" />

                    <!-- FATO / FRASE -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Fato"
                               FontSize="12"
                               TextColor="#94A3B8" />
                        <Label Text="{Binding Piada.Value}"
                               TextColor="#FFF"
                               FontSize="16"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- DATA DE CRIAÇÃO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Criado em"
                               FontSize="12"
                               TextColor="#94A3B8" />
                        <Label Text="{Binding Piada.CreatedAt}"
                               TextColor="#10B981"
                               FontSize="14" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>